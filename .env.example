EXPO_PUBLIC_API_URL=https://api.example.com

# NCP Maps 애플리케이션 Client ID. 하나의 애플리케이션에 Web 서비스 URL(웹 배포 도메인)과
# Android 패키지명 / iOS Bundle ID를 모두 등록해두면 네이티브/웹이 이 ID 하나를 공유해서 쓸 수 있음.
EXPO_PUBLIC_NAVER_MAP_CLIENT_ID=

# TourAPI (한국관광공사 PhokoAwrdService) service key — used by scripts/tour-photos only.
# No EXPO_PUBLIC_ prefix: this must never be bundled into the client app.
TOUR_API_SERVICE_KEY=
